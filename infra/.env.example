# Discord application (Developer Portal). The bot token lives ONLY in discord-mcp.
DISCORD_TOKEN=YOUR_BOT_TOKEN
DISCORD_CLIENT_ID=YOUR_APPLICATION_CLIENT_ID
DISCORD_BOT_REDIRECT_URI=http://localhost:3000/connect/callback

# Shared secret between the orchestrator and discord-mcp. Generate: openssl rand -hex 32
WHISPCORD_MCP_SECRET=CHANGE_ME

ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
WHISPCORD_PLANNER_MODEL=claude-sonnet-5-5

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

WEB_ORIGIN=http://localhost:3000
