{
  "name": "@whispcord/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "cli": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@fastify/cors": "11.4.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@supabase/supabase-js": "2.119.0",
    "@whispcord/shared": "0.1.0",
    "fastify": "5.12.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "vitest": "3.2.7"
  }
}
