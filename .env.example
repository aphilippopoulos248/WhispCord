# Copy to .env (repo root). One file configures the whole local stack:
# discord-mcp (scripts/run-discord-mcp.ps1), the orchestrator and the web app.

# ---- discord-mcp (Java) ----
SPRING_PROFILES_ACTIVE=http
# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
# Leave empty for Whispcord: the orchestrator passes the server ID on every call.
DISCORD_GUILD_ID=
# Shared secret between discord-mcp and the orchestrator. Generate: openssl rand -hex 32
WHISPCORD_MCP_SECRET=
WHISPCORD_EVENTS_WEBHOOK_URL=http://localhost:8787/internal/discord-events

# ---- orchestrator ----
DISCORD_CLIENT_ID=
DISCORD_BOT_REDIRECT_URI=http://localhost:3000/connect/callback
ANTHROPIC_API_KEY=
WHISPCORD_PLANNER_MODEL=claude-sonnet-5-5
WHISPCORD_PLANNER_EFFORT=medium
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=8787
WEB_ORIGIN=http://localhost:3000
DISCORD_MCP_URL=http://localhost:8085/mcp

# ---- web app ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:8787
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- optional orchestrator limits (defaults shown) ----
# MAX_RUNS_PER_SERVER_PER_HOUR=20
# MAX_RUNS_PER_USER_PER_HOUR=30
# RECONCILE_INTERVAL_MINUTES=15
# DISCONNECTED_RETENTION_DAYS=30
